[user]
	name = Hugo Vieira
	email = hugo.vieira2002@hotmail.com

[core]
	editor = nvim
	pager = delta

[interactive]
	# delta também no `git add -p`
	diffFilter = delta --color-only

# Temas do delta, vendorizados do repo do delta; troca-se em `features`.
[include]
	path = ~/.config/delta/themes.gitconfig

[delta]
	features = mellow-barbet
	# Rose Pine Moon como o resto; vem da cache do bat (`bat cache --build`).
	syntax-theme = rose-pine-moon

[init]
	defaultBranch = main

# Pessoal por omissão; ~/dev/ usa o email de trabalho, ~/dev/personal/ volta ao
# pessoal (o último lido ganha). config.work não é versionado; ver .example.
[includeIf "gitdir:~/dev/"]
	path = ~/.config/git/config.work

[includeIf "gitdir:~/dev/personal/"]
	path = ~/.config/git/config.personal
