font-size = 14
font-family = Liga SFMono Nerd Font

theme = Rose Pine Moon
background-opacity = 0.9
background-blur = macos-glass-regular

macos-titlebar-style = hidden

# Option esquerda é Alt (Alt+hjkl no herdr e no nvim); a direita continua a escrever os símbolos do teclado PT
macos-option-as-alt = left
# Copia o terminfo e o TERM para os servidores por ssh (sem isto: "unknown terminal type xterm-ghostty")
shell-integration-features = ssh-env,ssh-terminfo
