# Machine-specific zsh overrides. $ZDOTDIR is a stow symlink into this repo, so
# a .zshrc.local created at ~/.config/zsh/ lands here — keep it untracked.
zsh/.config/zsh/.zshrc.local

# zsh writes these next to the config when something bypasses ZDOTDIR.
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/*.zwc

.DS_Store

# Karabiner rewrites karabiner.json itself and drops dated copies here.
karabiner/.config/karabiner/automatic_backups/

# superfile writes its default hotkeys and every bundled theme into the config
# dir on first run and again after each upgrade. Only the Moon theme is ours.
superfile/.config/superfile/hotkeys.toml
superfile/.config/superfile/theme/*
!superfile/.config/superfile/theme/rose-pine-moon.toml
